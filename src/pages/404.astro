---
import Layout from "@/layouts/Layout.astro";
import { getTranslations } from "@/i18n";

const t = getTranslations("es");
const nf = t.notFound;
---

<Layout title={`${nf.code} · ${t.hero.name}`} lang="es" description={nf.title} altLang="en">
	<main class="grid min-h-screen place-items-center p-8">
		<div class="flex max-w-md flex-col items-center text-center">
			<p class="bg-gradient-to-b from-skin-hue to-skin-button-accent bg-clip-text text-8xl font-black leading-none text-transparent sm:text-9xl">
				{nf.code}
			</p>
			<h1 class="mt-6 text-2xl font-bold text-skin-base">{nf.title}</h1>
			<p class="mt-3 text-skin-muted">{nf.message}</p>
			<a
				href="/es/"
				class="mt-8 inline-flex items-center gap-2 rounded-lg bg-skin-button-accent px-5 py-2.5 text-sm font-medium text-skin-inverted transition-all hover:-translate-y-0.5 hover:opacity-90"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m12 19-7-7 7-7"></path>
					<path d="M19 12H5"></path>
				</svg>
				{nf.back}
			</a>
		</div>
	</main>
</Layout>
